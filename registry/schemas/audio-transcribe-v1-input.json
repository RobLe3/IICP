{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/audio-transcribe-v1-input.json",
  "title": "Audio Transcription (Speech-to-Text) input",
  "type": "object",
  "properties": {
    "audio": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64"
    },
    "filename": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]+)*$"
    },
    "response_format": {
      "type": "string",
      "enum": [
        "json",
        "text"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true,
  "required": [
    "audio"
  ]
}
