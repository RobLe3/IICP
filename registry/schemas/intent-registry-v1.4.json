{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/intent-registry-v1.4.json",
  "title": "IICP intent registry 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "updated",
    "authority",
    "description",
    "intents"
  ],
  "properties": {
    "schema": {
      "const": "https://iicp.network/registry/schemas/intent-registry-v1.4.json"
    },
    "version": {
      "const": "1.4.0"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urn",
          "name",
          "description",
          "payload_schema",
          "phase",
          "status",
          "kind",
          "declaration_version",
          "owner",
          "created",
          "updated",
          "review_by",
          "schemas",
          "compatibility",
          "references",
          "fixtures",
          "implementation_evidence",
          "status_history"
        ],
        "properties": {
          "urn": {
            "type": "string",
            "pattern": "^urn:iicp:intent:[a-z0-9_.-]+(?::[a-z0-9_./-]+)*:v[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "payload_schema": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "result_schema": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "phase": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "active",
              "experimental",
              "reserved",
              "deprecated",
              "withdrawn"
            ]
          },
          "kind": {
            "enum": [
              "analysis",
              "generation",
              "inference",
              "interactive",
              "ranking",
              "representation",
              "tool",
              "transformation"
            ]
          },
          "declaration_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "created": {
            "type": "string",
            "format": "date"
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "review_by": {
            "type": "string",
            "format": "date"
          },
          "schemas": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uri"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^registry/schemas/[A-Za-z0-9_.-]+\\.json$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uri"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^registry/schemas/[A-Za-z0-9_.-]+\\.json$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "legacy_payload_schema",
              "existing_urn_preserved"
            ],
            "properties": {
              "legacy_payload_schema": {
                "const": true
              },
              "existing_urn_preserved": {
                "const": true
              }
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?:https://|spec/|registry/)"
            }
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^registry/fixtures/[A-Za-z0-9_.-]+\\.json#/cases/[0-9]+$"
            }
          },
          "implementation_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "release",
                "repository",
                "evidence"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "release": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]+\\.[0-9]+$"
                },
                "repository": {
                  "type": "string",
                  "format": "uri"
                },
                "evidence": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "status_history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "date",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "experimental",
                    "reserved",
                    "deprecated",
                    "withdrawn"
                  ]
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "deprecated_by": {
            "type": "string",
            "pattern": "^urn:iicp:intent:[a-z0-9_.-]+(?::[a-z0-9_./-]+)*:v[1-9][0-9]*$"
          },
          "deprecated_since": {
            "type": "string",
            "format": "date"
          },
          "withdrawn_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
