{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/embedding-multimodal-v1-input.json",
  "title": "Multimodal Embedding input",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "inputs"
  ]
}
