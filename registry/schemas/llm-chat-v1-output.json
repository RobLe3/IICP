{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/llm-chat-v1-output.json",
  "title": "LLM Chat Completion output",
  "type": "object",
  "properties": {
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "object"
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "message"
        ]
      }
    },
    "usage": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "required": [
    "choices"
  ]
}
