{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/research-summarize-v1-input.json",
  "title": "Research Summarization input",
  "type": "object",
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "bullet",
        "paragraph",
        "abstract"
      ]
    },
    "max_length": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "documents"
  ]
}
