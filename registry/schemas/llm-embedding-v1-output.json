{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/llm-embedding-v1-output.json",
  "title": "Text Embedding output",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "embedding": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true,
        "required": [
          "embedding"
        ]
      }
    },
    "usage": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "required": [
    "data"
  ]
}
