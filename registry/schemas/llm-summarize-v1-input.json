{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/registry/schemas/llm-summarize-v1-input.json",
  "title": "LLM Summarization input",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "max_length": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "bullets",
        "paragraph",
        "headline"
      ]
    },
    "language": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "text"
  ]
}
