{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/ecosystem-version-truth-v1.json",
  "title": "IICP ecosystem three-axis version truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "content_free", "published_release", "deployed_release", "observed_adoption"],
  "properties": {
    "schema": { "const": "iicp.ecosystem-version-truth.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "content_free": { "const": true },
    "published_release": { "$ref": "#/$defs/publishedObservation" },
    "deployed_release": { "$ref": "#/$defs/deployedObservation" },
    "observed_adoption": { "$ref": "#/$defs/adoptionObservation" }
  },
  "$defs": {
    "status": { "enum": ["observed", "stale", "unavailable"] },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "lifecycle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lifecycle": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "observationBase": {
      "type": "object",
      "required": ["status", "observed_at", "evidence", "limitations"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 16
        }
      }
    },
    "publishedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "deploymentData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "components"],
      "properties": {
        "deployment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "deployment_record": { "type": "string", "format": "uri", "maxLength": 2048 },
        "deployment_record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "dependentRequired": {
        "deployment_record": ["deployment_record_digest"],
        "deployment_record_digest": ["deployment_record"]
      }
    },
    "adoptionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "count"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "adoptionData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "sample_size", "groups"],
      "properties": {
        "population": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sample_size": { "type": "integer", "minimum": 0 },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/adoptionGroup" } }
      }
    },
    "publishedObservation": {
      "allOf": [
        { "$ref": "#/$defs/observationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_at", "evidence", "limitations", "data"],
          "properties": {
            "status": { "$ref": "#/$defs/status" }, "observed_at": { "type": ["string", "null"], "format": "date-time" },
            "evidence": { "type": ["string", "null"], "format": "uri" }, "limitations": { "type": "array", "items": { "type": "string" } },
            "data": { "oneOf": [{ "$ref": "#/$defs/publishedData" }, { "type": "null" }] }
          }
        }
      ]
    },
    "deployedObservation": {
      "allOf": [
        { "$ref": "#/$defs/observationBase" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "observed_at", "evidence", "limitations", "data"],
          "properties": {
            "status": { "$ref": "#/$defs/status" }, "observed_at": { "type": ["string", "null"], "format": "date-time" },
            "evidence": { "type": ["string", "null"], "format": "uri" }, "limitations": { "type": "array", "items": { "type": "string" } },
            "data": { "oneOf": [{ "$ref": "#/$defs/deploymentData" }, { "type": "null" }] }
          }
        }
      ]
    },
    "adoptionObservation": {
      "allOf": [
        { "$ref": "#/$defs/observationBase" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "observed_at", "evidence", "limitations", "data"],
          "properties": {
            "status": { "$ref": "#/$defs/status" }, "observed_at": { "type": ["string", "null"], "format": "date-time" },
            "evidence": { "type": ["string", "null"], "format": "uri" }, "limitations": { "type": "array", "items": { "type": "string" } },
            "data": { "oneOf": [{ "$ref": "#/$defs/adoptionData" }, { "type": "null" }] }
          }
        }
      ]
    }
  }
}
