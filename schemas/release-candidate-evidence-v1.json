{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/release-candidate-evidence-v1.json",
  "title": "IICP release-candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "generated_at",
    "state",
    "overall_status",
    "published",
    "components",
    "review_checkpoint"
  ],
  "properties": {
    "schema": { "const": "iicp.release-candidate-evidence.v1" },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generated_at": { "type": "string", "format": "date-time" },
    "state": { "const": "candidate" },
    "overall_status": { "enum": ["pass", "fail"] },
    "published": { "const": false },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "commit", "version", "worktree_clean", "checks", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "version": { "type": "string", "minLength": 1 },
          "worktree_clean": { "type": "boolean" },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pass", "fail"] }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "sha256", "second_build_sha256", "byte_equivalent"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "second_build_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "byte_equivalent": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "review_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["pending", "approved", "not_required"] }
      }
    }
  }
}
