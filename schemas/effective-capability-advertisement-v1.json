{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/effective-capability-advertisement-v1.json",
  "title": "IICP effective capability advertisement v1",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "stringSet": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "limit": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "enum": ["tokens", "items", "bytes", "milliseconds", "dimensions"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["heuristic_fallback", "operator_assertion", "provider_metadata", "runtime_introspection", "conformance_probe"]
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "extension": {
      "type": "object",
      "required": ["required", "value"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "value": {}
      }
    },
    "capability": {
      "type": "object",
      "required": ["intent"],
      "additionalProperties": false,
      "properties": {
        "intent": {"type": "string", "pattern": "^urn:iicp:intent:[a-z0-9_.-]+(?::[a-z0-9_./-]+)*:v[1-9][0-9]*$", "maxLength": 255},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "phase": {"type": "integer", "minimum": 1},
        "variant_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "models": {"$ref": "#/$defs/stringSet"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "input_modalities": {"$ref": "#/$defs/stringSet"},
        "output_modalities": {"$ref": "#/$defs/stringSet"},
        "features": {"$ref": "#/$defs/stringSet"},
        "execution_capabilities": {"$ref": "#/$defs/stringSet"},
        "limits": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/limit"}
        },
        "supported_profiles": {"$ref": "#/$defs/stringSet"},
        "claim_provenance": {"$ref": "#/$defs/provenance"},
        "extensions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"minLength": 3, "maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/extension"}
        }
      }
    }
  }
}
