  "scope_rule": "A coordinated stable designation may cover only REQUIRED_STABLE and COMPATIBILITY_ANCHOR capabilities. Optional, experimental, research and unsupported surfaces remain outside that claim unless a later reviewed baseline adds them and their full evidence passes.",
  "classification_semantics": {
    "REQUIRED_STABLE": "Required in every applicable declared support cell before coordinated promotion.",
    "COMPATIBILITY_ANCHOR": "Existing behavior required to preserve compatibility while its replacement or retirement remains separately gated.",
    "OPTIONAL_STABLE": "A supported additive surface that does not block the coordinated baseline when absent from a component.",
    "EXPERIMENTAL": "Implemented or useful, but excluded from the coordinated stable claim.",
    "RESEARCH": "A question or candidate mechanism, not a release commitment.",
    "UNSUPPORTED": "Explicitly outside the declared baseline. It must not be inferred from adjacent support."
  },
  "compatibility_rules": {
    "unknown_required_data": "fail_closed",
    "unknown_optional_data": "ignore_or_negotiate_as_declared",
    "directory_authority": "php_genesis_preserved",
