    "unknown_optional": "omit_only_if_all_required_constraints_remain_satisfied",
    "dependency": "all_transitive_dependencies_required",
    "incompatibility": "reject_before_execution",
    "downgrade": "prohibited",
    "deprecation": "semantics_remain_stable_until_explicit_replacement"
