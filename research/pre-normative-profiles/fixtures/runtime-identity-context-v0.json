  "cases": [
    {
      "name": "chat_can_receive_explicit_identity_context",
      "request": {
        "intent": "urn:iicp:intent:llm:chat:v1",
        "mode": "explicit",
        "messages": [
          {
            "role": "user",
            "content": "What is this?"
          }
        ]
      },
      "facts": {
        "intent": {
          "value": "urn:iicp:intent:llm:chat:v1",
          "source": "validated_task",
          "disclosure": "safe_default"
        }
      },
      "expected": {
        "action": "compose_once",
        "identity_boundary": "selected_service_not_iicp",
        "missing_facts": "omit_and_do_not_guess",
        "application_messages": "preserve"
      }
    },
    {
      "name": "disabled_mode_preserves_chat_payload",
      "request": {
        "intent": "urn:iicp:intent:llm:chat:v1",
        "mode": "disabled",
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      },
      "expected": {
        "action": "no_change",
        "application_messages": "byte_equivalent"
      }
    },
    {
      "name": "application_system_message_is_not_rewritten",
      "request": {
        "intent": "urn:iicp:intent:llm:chat:v1",
        "mode": "explicit",
        "messages": [
          {
            "role": "system",
            "content": "Answer in one sentence."
          },
          {
            "role": "user",
            "content": "What is IICP?"
          }
        ]
      },
      "expected": {
        "action": "compose_without_rewriting_application_messages",
        "application_system_content": "Answer in one sentence.",
        "ordering": "after_leading_system_or_developer_before_first_user"
      }
    },
    {
      "name": "existing_marker_suppresses_duplicate",
      "request": {
        "intent": "urn:iicp:intent:llm:chat:v1",
        "mode": "explicit",
        "messages": [
          {
            "role": "system",
            "content": "[IICP-RUNTIME-CONTEXT/1] existing canonical context"
          },
          {
            "role": "user",
            "content": "What is this?"
          }
        ]
      },
      "expected": {
        "action": "no_change",
        "reason": "duplicate_marker",
        "marker_count": 1
      }
    },
    {
