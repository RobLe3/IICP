  "tracking_issue": "https://github.com/RobLe3/IICP/issues/158",
  "purpose": "Classify lean model-visible IICP runtime identity context without creating an assistant persona, changing non-chat semantics, or exposing private routing state.",
  "base_capsule": "This request reached you through IICP, the Intent-based Inter-agent Communication Protocol. IICP discovers eligible services and routes requests. You are the selected model or service, not IICP. When asked about this connection, use only supplied runtime facts; do not guess missing facts.",
  "base_capsule_measurement": {
    "date": "2026-08-14",
    "runtime": "Ollama OpenAI-compatible chat",
    "model": "qwen2.5:0.5b",
    "baseline_prompt_tokens": 35,
    "capsule_prompt_tokens": 77,
    "measured_overhead_tokens": 42,
    "capsule_characters": 289,
    "capsule_words": 42,
    "scope": "single local runtime measurement; not a tokenizer-independent guarantee"
  },
  "initial_applicability": [
    "urn:iicp:intent:llm:chat:v1"
  ],
  "disclosure_classes": [
    "safe_default",
    "optional",
    "policy_controlled",
    "never_inject"
  ],
  "safe_selection_reasons": [
    "matched_intent_and_constraints",
    "explicit_model_match",
    "fallback_after_unavailable_candidate",
    "intentional_exploration"
