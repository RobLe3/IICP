    "next_window_age_seconds": 3600,
    "next_window_score_after_first_positive": 0.8,
    "next_window_hourly_gain_after_first_positive": 0.1,
    "final_score_after_reload_and_negative": 0.85,
    "final_hourly_gain": 0.2
  },
  "result_contract": {
    "required_fields": [
      "fixture_version",
      "implementation_flavor",
      "database_mode",
      "concurrent_score",
      "concurrent_hourly_gain",
      "concurrent_tasks_total",
      "same_window_score",
