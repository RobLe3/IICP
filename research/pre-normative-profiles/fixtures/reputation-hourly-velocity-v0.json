  "inputs": {
    "initial_reputation": 0.5,
    "positive_delta_per_heartbeat": 0.1,
    "maximum_hourly_positive_gain": 0.2,
    "workers": 4,
    "tasks_success_per_worker": 10,
    "negative_delta_after_reload": -0.05
  },
  "expected": {
    "concurrent_score": 0.7,
    "concurrent_hourly_gain": 0.2,
    "concurrent_tasks_total": 40,
    "same_window_age_seconds": 3599,
