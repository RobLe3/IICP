{
  "schema": "iicp.e050_client_credential_lifecycle.v1",
  "status": "implementation-evidence-only",
  "wire_change": false,
  "production_activation_authorized": false,
  "scenarios": [
    {
      "id": "fresh-registration",
      "starting_token": null,
      "requested_endpoint": "https://old-tunnel.example",
      "directory_status": 201,
      "directory_token": "token-1",
      "expected_request_token": null,
      "expected_saved_token": "token-1",
      "expected_endpoint_committed": true
    },
    {
      "id": "tunnel-rotation",
      "starting_token": "token-1",
      "requested_endpoint": "https://new-tunnel.example",
      "directory_status": 201,
      "directory_token": "token-2",
      "expected_request_token": "token-1",
      "expected_saved_token": "token-2",
      "expected_endpoint_committed": true
    },
    {
      "id": "supervised-restart",
      "starting_token": "token-2",
      "requested_endpoint": "https://new-tunnel.example",
      "directory_status": 201,
      "directory_token": "token-3",
      "expected_request_token": "token-2",
      "expected_saved_token": "token-3",
      "expected_endpoint_committed": true
    },
    {
      "id": "stale-token-replay",
      "starting_token": "token-1",
      "requested_endpoint": "https://attacker.example",
      "directory_status": 403,
      "directory_token": null,
      "expected_request_token": "token-1",
      "expected_saved_token": "token-1",
      "expected_endpoint_committed": false
    },
    {
      "id": "failed-current-token-rotation",
      "starting_token": "token-2",
      "requested_endpoint": "https://rejected-tunnel.example",
      "directory_status": 403,
      "directory_token": null,
      "expected_request_token": "token-2",
      "expected_saved_token": "token-2",
      "expected_endpoint_committed": false
    }
  ],
  "invariants": {
    "send_current_token_when_present": true,
    "persist_only_accepted_successor": true,
    "failed_registration_preserves_saved_token": true,
    "failed_registration_preserves_last_accepted_route": true,
    "external_directory_loss_is_not_runtime_death": true
  }
}
