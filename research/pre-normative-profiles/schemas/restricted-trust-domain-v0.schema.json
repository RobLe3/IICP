{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/restricted-trust-domain-v0.schema.json",
  "title": "IICP restricted trust-domain semantic fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "status", "profile", "reason_order", "vectors"],
  "properties": {
    "fixture_version": {"const": "0.1.0-draft"},
    "status": {"const": "pre-normative"},
    "profile": {"const": "urn:iicp:profile:restricted-trust-domain:v1"},
    "reason_order": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "vectors": {
      "type": "array",
      "minItems": 20,
      "items": {"$ref": "#/$defs/vector"}
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case", "description", "input", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^CUG-(0[1-9]|10)(-[A-Z0-9]+)+$"},
        "case": {"type": "string", "pattern": "^CUG-(0[1-9]|10)$"},
        "description": {"type": "string", "minLength": 8, "maxLength": 180},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operation"],
      "properties": {
        "mode": {"enum": ["public", "private", "federated_private", "local_only", "custom", "invalid"]},
        "operation": {"enum": ["registration", "discovery", "bootstrap", "gossip", "relay", "execution", "cip", "federation"]},
        "external_network": {"type": "boolean"},
        "public_fallback": {"type": "boolean"},
        "profile_support": {"enum": ["supported", "unknown_required", "unknown_optional"]},
        "authenticated": {"type": "boolean"},
        "replayed": {"type": "boolean"},
        "membership": {"enum": ["valid", "missing", "expired", "revoked", "wrong_domain"]},
        "federation_trusted": {"type": "boolean"},
        "federation_scope_allowed": {"type": "boolean"},
        "policy_allowed": {"type": "boolean"},
        "route_authorized": {"type": "boolean"},
        "cached_authority": {"type": "boolean"},
        "after_restart": {"type": "boolean"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "network_activity_permitted"],
      "properties": {
        "decision": {"enum": ["allow", "deny"]},
        "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "network_activity_permitted": {"type": "boolean"}
      }
    }
  }
}
