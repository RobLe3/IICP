{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/public-measurement-profile-v1.schema.json",
  "title": "IICP public multi-vantage measurement evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "schema_version", "evidence_class", "claim", "window", "vantages", "observations", "summary", "privacy"],
  "properties": {
    "profile": {"const": "iicp-public-measurement-v1"},
    "schema_version": {"const": 1},
    "evidence_class": {"enum": ["self-observed", "project-observed", "external-observed", "independent"]},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "target_class", "target_id"],
      "properties": {
        "scope": {"enum": ["single-vantage", "regional", "multi-region", "network-wide"]},
        "target_class": {"enum": ["directory", "provider", "relay", "website", "public-evidence"]},
        "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      }
    },
    "vantages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vantage_id", "operator_id", "failure_domain_id", "region", "network_class", "target_controlled"],
        "properties": {
          "vantage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "operator_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "failure_domain_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "region": {"type": "string", "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"},
          "network_class": {"enum": ["residential", "mobile", "academic", "cloud", "hosting", "enterprise", "other"]},
          "target_controlled": {"type": "boolean"}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "vantage_id", "observed_at", "outcome"],
        "properties": {
          "sample_id": {"type": "integer", "minimum": 1},
          "vantage_id": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "outcome": {"enum": ["success", "http_error", "transport_error", "timeout", "invalid_response", "not_run"]},
          "latency_ms": {"type": "integer", "minimum": 0},
          "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
          "reason_code": {"enum": ["HTTP_STATUS", "CONNECT_FAILED", "TLS_FAILED", "DNS_FAILED", "DEADLINE_EXCEEDED", "SCHEMA_INVALID", "SCHEDULE_MISSED"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_samples", "successful_samples", "failed_samples", "availability", "latency_sample_count", "outcomes", "aggregation"],
      "properties": {
        "requested_samples": {"type": "integer", "minimum": 1},
        "successful_samples": {"type": "integer", "minimum": 0},
        "failed_samples": {"type": "integer", "minimum": 0},
        "availability": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_sample_count": {"type": "integer", "minimum": 0},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "p50", "p95", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "p50": {"type": "integer", "minimum": 0},
            "p95": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["success", "http_error", "transport_error", "timeout", "invalid_response", "not_run"],
          "properties": {
            "success": {"type": "integer", "minimum": 0},
            "http_error": {"type": "integer", "minimum": 0},
            "transport_error": {"type": "integer", "minimum": 0},
            "timeout": {"type": "integer", "minimum": 0},
            "invalid_response": {"type": "integer", "minimum": 0},
            "not_run": {"type": "integer", "minimum": 0}
          }
        },
        "aggregation": {"const": "nearest-rank-v1"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_free", "identifiers_scoped_to_bundle"],
      "properties": {
        "content_free": {"const": true},
        "identifiers_scoped_to_bundle": {"const": true}
      }
    }
  }
}
