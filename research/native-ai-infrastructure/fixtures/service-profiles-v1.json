  "admission_vectors": [
    {
      "id": "ADMISSION-01",
      "name": "ready provider accepts bounded work",
      "provider": {
        "availability": "ready",
        "deadline_support": true
      },
      "request": {
        "timeout_ms": 1000
      },
      "expected": {
        "outcome": "accepted"
      }
    },
    {
      "id": "ADMISSION-02",
      "name": "unknown required profile rejects before execution",
      "provider": {
        "supported_profiles": []
      },
      "request": {
        "required_profiles": [
          "urn:iicp:profile:unknown:v1"
        ]
      },
      "expected": {
        "outcome": "unsupported_profile",
        "billable_execution": false
      }
    },
    {
      "id": "ADMISSION-03",
      "name": "capacity exhaustion is bounded",
      "provider": {
        "availability": "ready",
        "slot_available": false
      },
      "request": {},
      "expected": {
        "outcome": "capacity_exceeded",
        "http_status": 429,
        "billable_execution": false
      }
    },
    {
      "id": "ADMISSION-04",
      "name": "draining provider accepts no new work",
      "provider": {
        "availability": "draining"
      },
      "request": {},
      "expected": {
        "outcome": "temporarily_unavailable",
        "billable_execution": false
      }
    },
    {
      "id": "ADMISSION-05",
      "name": "unachievable deadline rejects before acceptance",
      "provider": {
        "availability": "ready",
        "deadline_support": true,
        "can_meet_deadline": false
      },
      "request": {
        "timeout_ms": 1
      },
      "expected": {
        "outcome": "deadline_unachievable",
        "billable_execution": false
      }
    },
    {
      "id": "ADMISSION-06",
      "name": "advertisement remains topology-redacted",
      "provider": {
        "availability": "ready",
        "capacity_class": "standard",
        "deadline_support": true
      },
      "expected": "advertise only availability, capacity_class, deadline_support, and supported_profiles; omit queue, peer, route, shard, and scheduler fields"
